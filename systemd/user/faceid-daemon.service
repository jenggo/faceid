[Unit]
Description=FaceID Authentication Daemon
Documentation=man:faceid-daemon(1)
After=dbus.service graphical-session-pre.target
Wants=dbus.service graphical-session-pre.target

# Start after session is ready but don't hard require graphical session
# This allows daemon to work in headless environments too
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.freedesktop.FaceID

# Daemon binary location
ExecStart=/usr/bin/faceid-daemon

# Restart on failure
Restart=on-failure
RestartSec=5

# Timeout for graceful shutdown
TimeoutStopSec=10

# Hardening directives (relaxed for user service)
# User services don't need strict sandboxing like system daemons
NoNewPrivileges=yes
PrivateTmp=yes
# Note: ProtectSystem=strict is too restrictive for user services
# that need to access home directory configs
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
SystemCallFilter=~@clock @debug @module @obsolete @privileged @reboot @setuid @swap
SystemCallErrorNumber=EPERM

# Resource limits
# Temporarily disable memory limit for debugging OOM issue
# MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=graphical-session.target
